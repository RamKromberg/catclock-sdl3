// ============================================================================
// 3. CONTINUOUS FLOAT COUNTERBALANCE ORIGIN ENGINE
// ============================================================================
static void CatClock_CalculateHandOriginsFloat(int phase, float pivot_x, float pivot_y, float scale,
											   float back_pivot_length, float* out_back_x,
											   float* out_back_y) {
	float max_back_x = 0.0f, max_back_y = 0.0f;
	// Invert phase context by exactly 180 degrees (+30 frames wrapped)
	int inverted_phase = (phase + 30) % TOTAL_HAND_PHASES;

	// Sample the foundational unclipped perspective engine using the inverted frame step
	CatClock_CalculateHandEndpointsFloat(inverted_phase, pivot_x, pivot_y, scale, &max_back_x,
										 &max_back_y);

	// Extract the true un-truncated directional deltas from the center pivot axis
	float delta_back_x = max_back_x - pivot_x;
	float delta_back_y = max_back_y - pivot_y;
	float full_back_dist = sqrtf(delta_back_x * delta_back_x + delta_back_y * delta_back_y);

	if (full_back_dist < 1.0f) {
		full_back_dist = 1.0f;
	}

	// Scale the raw continuous vector uniformly backward along its true tracking path
	float back_scalar = (back_pivot_length * scale) / full_back_dist;
	*out_back_x = pivot_x + (delta_back_x * back_scalar);
	*out_back_y = pivot_y + (delta_back_y * back_scalar);
}

static void CatClock_CalculateHandOrigins(int phase, int pivot_x, int pivot_y, float scale,
										  float back_pivot_length, int* out_back_x,
										  int* out_back_y) {
	float raw_back_x = 0.0f;
	float raw_back_y = 0.0f;

	// 1. Query the continuous float engine to secure true geometric counterweights
	CatClock_CalculateHandOriginsFloat(phase, (float) pivot_x, (float) pivot_y, scale,
									   back_pivot_length, &raw_back_x, &raw_back_y);

	// 2. Enforce explicit phase overrides for perfect cardinal layout tracking
	if (phase == 0 || phase == 15 || phase == 30 || phase == 45) {
		*out_back_x = (int) roundf(raw_back_x);
		*out_back_y = (int) roundf(raw_back_y);
	} else {
		// 3. Apply targeted rounding switches matching the quadrant-phase context
		int quadrant = (phase / 15) % 4;
		switch (quadrant) {
		case 0: // Hand is Top-Right -> Tail points Bottom-Left (-X, +Y in texture offsets)
			*out_back_x = (int) ceilf(raw_back_x - 0.5f);
			*out_back_y = (int) floorf(raw_back_y + 0.5f);
			break;
		case 1: // Hand is Bottom-Right -> Tail points Top-Left (-X, -Y in texture offsets)
			*out_back_x = (int) ceilf(raw_back_x - 0.5f);
			*out_back_y = (int) ceilf(raw_back_y - 0.5f);
			break;
		case 2: // Hand is Bottom-Left -> Tail points Top-Right (+X, -Y in texture offsets)
			*out_back_x = (int) floorf(raw_back_x + 0.5f);
			*out_back_y = (int) ceilf(raw_back_y - 0.5f);
			break;
		case 3: // Hand is Top-Left -> Tail points Bottom-Right (+X, +Y in texture offsets)
			*out_back_x = (int) floorf(raw_back_x + 0.5f);
			*out_back_y = (int) floorf(raw_back_y + 0.5f);
			break;
		}
	}
}

// ============================================================================
// 4. UNQUANTIZED SYMMETRICAL PERPENDICULAR NORMAL GENERATOR
// ============================================================================
static void CatClock_CalculateHandBaseCornersFloat(int phase, float back_x, float back_y,
												   float scale, float base_width,
												   float* out_start_x, float* out_start_y,
												   float* out_end_x, float* out_end_y) {
	// 1. Compute precise master reference tracking angle
	float angle_rad
		= ((float) (phase % TOTAL_HAND_PHASES) / (float) TOTAL_HAND_PHASES) * 2.0f * (float) M_PI;
	float half_width_scaled = (base_width / 2.0f) * scale;
	float normal_dx = cosf(angle_rad);
	float o_normal_dy = sinf(angle_rad);
	switch (phase) {
	case 0:
		normal_dx = 1.0f;
		o_normal_dy = 0.0f;
		break;
	case 15:
		normal_dx = 0.0f;
		o_normal_dy = 1.0f;
		break;
	case 30:
		normal_dx = -1.0f;
		o_normal_dy = 0.0f;
		break;
	case 45:
		normal_dx = 0.0f;
		o_normal_dy = -1.0f;
		break;
	}

	// 4. Project coordinates symmetrically in floating-point model space
	*out_start_x = back_x + (normal_dx * half_width_scaled);
	*out_start_y = back_y + (o_normal_dy * half_width_scaled);
	*out_end_x = back_x - (normal_dx * half_width_scaled);
	*out_end_y = back_y - (o_normal_dy * half_width_scaled);
}

static void CatClock_CalculateHandBaseCorners(int phase, float spine_dx, float spine_dy,
											  float back_x, float back_y, float scale,
											  float base_width, int* out_start_x, int* out_start_y,
											  int* out_end_x, int* out_end_y) {
	float raw_start_x = 0.0f, raw_start_y = 0.0f;
	float raw_end_x = 0.0f, raw_end_y = 0.0f;

	// 1. Query the unquantized float engine to secure continuous trig terminals
	CatClock_CalculateHandBaseCornersFloat(phase, back_x, back_y, scale, base_width, &raw_start_x,
										   &raw_start_y, &raw_end_x, &raw_end_y);

	int target_total_width = (int) roundf(base_width * scale);
	int step_offset = target_total_width / 2;

	// 2. Enforce strict phase context overrides for perfect cardinal axes
	if (phase == 0 || phase == 30) {
		*out_start_x = (int) roundf(back_x) + step_offset;
		*out_start_y = (int) roundf(back_y);
		*out_end_x = (int) roundf(back_x) - step_offset;
		*out_end_y = (int) roundf(back_y);
		return;
	}
	if (phase == 15 || phase == 45) {
		*out_start_x = (int) roundf(back_x);
		*out_start_y = (int) roundf(back_y) + step_offset;
		*out_end_x = (int) roundf(back_x);
		*out_end_y = (int) roundf(back_y) - step_offset;
		return;
	}

	// 3. Convert intermediate diagonal frames using clean sub-pixel centering
	*out_start_x = (int) floorf(raw_start_x + 0.5f);
	*out_start_y = (int) floorf(raw_start_y + 0.5f);
	*out_end_x = (int) floorf(raw_end_x + 0.5f);
	*out_end_y = (int) floorf(raw_end_y + 0.5f);

	// 4. Correct rounding drift using explicit phase-isolated direction rules
	int footprint_w = abs(*out_start_x - *out_end_x) + 1;
	int footprint_h = abs(*out_start_y - *out_end_y) + 1;
	int current_thickness = (fabsf(spine_dx) > fabsf(spine_dy)) ? footprint_h : footprint_w;

	if (current_thickness > target_total_width) {
		// Isolate the true directional signs based on the master animation phase
		int sign_x = 1;
		int sign_y = 1;

		if (phase > 0 && phase < 15) {
			sign_x = 1;
			sign_y = 1;
		} else if (phase > 15 && phase < 30) {
			sign_x = -1;
			sign_y = 1;
		} else if (phase > 30 && phase < 45) {
			sign_x = -1;
			sign_y = -1;
		} else if (phase > 45 && phase < 60) {
			sign_x = 1;
			sign_y = -1;
		}

		// Symmetrically nudge endpoints outward based on the dominant path direction
		if (fabsf(spine_dx) > fabsf(spine_dy)) {
			*out_start_x = (int) roundf(raw_start_x);
			*out_start_y = (int) roundf(back_y) + (sign_y * step_offset);
			*out_end_x = (int) roundf(raw_end_x);
			*out_end_y = (int) roundf(back_y) - (sign_y * step_offset);
		} else {
			*out_start_x = (int) roundf(back_x) + (sign_x * step_offset);
			*out_start_y = (int) roundf(raw_start_y);
			*out_end_x = (int) roundf(back_x) - (sign_x * step_offset);
			*out_end_y = (int) roundf(back_y) - (sign_x * step_offset);
		}
	}
}

// ============================================================================
// 5. FORE-SHORTENED HAND TIP SCALER
// ============================================================================
static void CatClock_CalculateHandTipFloat(int phase, float pivot_x, float pivot_y, float forward_x,
										   float forward_y, float length_multiplier,
										   float* out_tip_x, float* out_tip_y) {
	// 1. Extract the raw high-precision length deltas along the backbone spine
	float delta_x = forward_x - pivot_x;
	float delta_y = forward_y - pivot_y;

	// 2. Isolate the target direction signs based on the master animation phase
	int quadrant = (phase / 15) % 4;
	float scale_sign_x = 1.0f;
	float scale_sign_y = 1.0f;

	switch (quadrant) {
	case 0:
		scale_sign_x = 1.0f;
		scale_sign_y = 1.0f;
		break; // Top-Right
	case 1:
		scale_sign_x = 1.0f;
		scale_sign_y = -1.0f;
		break; // Bottom-Right
	case 2:
		scale_sign_x = -1.0f;
		scale_sign_y = -1.0f;
		break; // Bottom-Left
	case 3:
		scale_sign_x = -1.0f;
		scale_sign_y = 1.0f;
		break; // Top-Left
	}

	// 3. Project continuous tip layout vector without any rounding functions
	*out_tip_x = pivot_x + (fabsf(delta_x) * length_multiplier * scale_sign_x);
	*out_tip_y = pivot_y + (fabsf(delta_y) * length_multiplier * scale_sign_y);
}

static void CatClock_CalculateHandTip(int phase, int pivot_x, int pivot_y, int forward_x,
									  int forward_y, float length_multiplier, int* out_tip_x,
									  int* out_tip_y) {
	float raw_tip_x = 0.0f;
	float raw_tip_y = 0.0f;

	// 1. Query the continuous float engine to preserve sub-pixel vector reaches
	CatClock_CalculateHandTipFloat(phase, (float) pivot_x, (float) pivot_y, (float) forward_x,
								   (float) forward_y, length_multiplier, &raw_tip_x, &raw_tip_y);

	int quadrant = (phase / 15) % 4;

	// 2. Enforce strict phase context overrides for perfect cardinal boundaries
	if (phase == 0 || phase == 15 || phase == 30 || phase == 45) {
		*out_tip_x = (int) roundf(raw_tip_x);
		*out_tip_y = (int) roundf(raw_tip_y);
	} else if (phase == 39) {
		*out_tip_x = (int) ceilf(raw_tip_x - 0.5f);
		*out_tip_y = (int) ceilf(raw_tip_y - 0.5f);
	} else {
		switch (quadrant) {
		case 0:
			*out_tip_x = (int) floorf(raw_tip_x + 0.5f);
			*out_tip_y = (int) floorf(raw_tip_y + 0.5f);
			break;
		case 1:
			*out_tip_x = (int) floorf(raw_tip_x + 0.5f);
			*out_tip_y = (int) ceilf(raw_tip_y - 0.5f);
			break;
		case 2:
			*out_tip_x = (int) ceilf(raw_tip_x - 0.5f);
			*out_tip_y = (int) ceilf(raw_tip_y - 0.5f);
			break;
		case 3:
			*out_tip_x = (int) ceilf(raw_tip_x - 0.5f);
			*out_tip_y = (int) floorf(raw_tip_y + 0.5f);
			break;
		}
	}
}
