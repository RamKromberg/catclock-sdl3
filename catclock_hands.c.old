#include "catclock_shared.h"
#include <math.h>
#include <stdlib.h>
#include <stdio.h>

// ============================================================================
// STRUCTURAL INTERNAL FORWARD DECLARATIONS
// ============================================================================
static void CatClock_CalculateHandEndpointsFloat(int phase, float pivot_x, float pivot_y,
												 float scale, float* out_end_x, float* out_end_y);

static void CatClock_CalculateHandEndpoints(int phase, int pivot_x, int pivot_y, float scale,
											int cell_x, int cell_y, int* out_end_x, int* out_end_y);

static void CatClock_CalculateHandOriginsFloat(int phase, float pivot_x, float pivot_y, float scale,
											   float back_pivot_length, float* out_back_x,
											   float* out_back_y);

static void CatClock_CalculateHandOrigins(int phase, int pivot_x, int pivot_y, float scale,
										  float back_pivot_length, int* out_back_x,
										  int* out_back_y);

static void CatClock_CalculateHandBaseCornersFloat(int phase, float back_x, float back_y,
												   float scale, float base_width,
												   float* out_start_x, float* out_start_y,
												   float* out_end_x, float* out_end_y);

static void CatClock_CalculateHandBaseCorners(int phase, float spine_dx, float spine_dy,
											  float back_x, float back_y, float scale,
											  float base_width, int* out_start_x, int* out_start_y,
											  int* out_end_x, int* out_end_y);

static void CatClock_CalculateHandTipFloat(int phase, float pivot_x, float pivot_y, float forward_x,
										   float forward_y, float length_multiplier,
										   float* out_tip_x, float* out_tip_y);

static void CatClock_CalculateHandTip(int phase, int pivot_x, int pivot_y, int forward_x,
									  int forward_y, float length_multiplier, int* out_tip_x,
									  int* out_tip_y);

// ============================================================================
// SYSTEM ASSET GEOMETRY CONSTANTS
// ============================================================================
const int TEXTURE_CELL_W = 64;
const int TEXTURE_CELL_H = 96;
const int CLOCKFACE_W = 59;
const int CLOCKFACE_H = 83;
const int ENVELOPE_PAD_X = 2;
const int ENVELOPE_PAD_Y = 6;
const int RELATIVE_FOCAL_X = 29;
const int RELATIVE_FOCAL_Y = 39;
const int PIVOT_AXIS_X = ENVELOPE_PAD_X + RELATIVE_FOCAL_X;
const int PIVOT_AXIS_Y = ENVELOPE_PAD_Y + RELATIVE_FOCAL_Y;

typedef struct {
	int dx; // Exact 1x horizontal pixel offset from focal center
	int dy; // Exact 1x vertical pixel offset from focal center
} HandMasterOffset;

static const HandMasterOffset HAND_MASTER_OFFSETS[TOTAL_HAND_PHASES]
	= { { 0, -39 },	  { 4, -39 },	{ 8, -38 },	  { 12, -37 },	{ 15, -35 },  { 19, -32 },
		{ 22, -30 },  { 24, -27 },	{ 26, -24 },  { 27, -20 },	{ 28, -16 },  { 29, -13 },
		{ 29, -10 },  { 29, -6 },	{ 29, -3 },	  { 29, 0 },	{ 29, 3 },	  { 29, 6 },
		{ 29, 10 },	  { 29, 13 },	{ 29, 17 },	  { 29, 21 },	{ 28, 25 },	  { 26, 29 },
		{ 23, 32 },	  { 20, 36 },	{ 17, 38 },	  { 13, 40 },	{ 9, 42 },	  { 5, 43 },
		{ 0, 43 },	  { -5, 43 },	{ -9, 42 },	  { -13, 40 },	{ -17, 38 },  { -20, 35 },
		{ -23, 32 },  { -26, 29 },	{ -28, 25 },  { -29, 21 },	{ -29, 17 },  { -29, 13 },
		{ -29, 10 },  { -29, 6 },	{ -29, 3 },	  { -29, 0 },	{ -29, -3 },  { -29, -6 },
		{ -29, -10 }, { -29, -13 }, { -28, -16 }, { -27, -20 }, { -26, -24 }, { -24, -26 },
		{ -22, -30 }, { -19, -33 }, { -15, -35 }, { -12, -37 }, { -8, -38 },  { -4, -39 } };

void CatClock_ShaderHands(void* renderer, int cell_x, int cell_y, int sheet_w, int sheet_h,
						  int frame_idx, void* userdata) {
	uint8_t* buffer = (uint8_t*) renderer;
	struct {
		int type;
		SDL_Color color;
	}* hand_cfg = (typeof(hand_cfg)) userdata;

	float scale = (float) ctx.current_half_steps / 2.0f;
	int phase = frame_idx % TOTAL_HAND_PHASES;

	float back_pivot_length = 7.0f;
	float length_multiplier = 1.000f;
	float base_width = 3.0f;
	uint8_t palette_hand_idx = PALETTE_HAND_SECOND;
	int hand_type = hand_cfg ? hand_cfg->type : 0;

	float mid_factor = 0.45f;

	if (hand_type == HAND_TYPE_HOUR) {
		back_pivot_length = 3.0f;
		length_multiplier = 3.0f / 7.0f;
		base_width = 7.0f;
		palette_hand_idx = PALETTE_HAND_HOUR;
		mid_factor = 0.22f;
	} else if (hand_type == HAND_TYPE_MINUTE) {
		back_pivot_length = 5.0f;
		length_multiplier = 5.0f / 7.0f;
		base_width = 5.0f;
		palette_hand_idx = PALETTE_HAND_MINUTE;
		mid_factor = 0.33f;
	} else {
		back_pivot_length = 7.0f;
		length_multiplier = 1.000f;
		base_width = 3.0f;
		palette_hand_idx = PALETTE_HAND_SECOND;
		mid_factor = 0.45f;
	}
	(void) length_multiplier;

	// 1. Establish high-precision floating point local focal points
	float pivot_axis_xf = (float) cell_x + ((float) PIVOT_AXIS_X * scale);
	float pivot_axis_yf = (float) cell_y + ((float) PIVOT_AXIS_Y * scale);

	float back_origin_xf = 0.0f, back_origin_yf = 0.0f;
	float forward_edge_xf = 0.0f, forward_edge_yf = 0.0f;

	// 2. Extract continuous unclipped coordinates to prevent vector quantization errors
	CatClock_CalculateHandEndpointsFloat(phase, pivot_axis_xf, pivot_axis_yf, scale,
										 &forward_edge_xf, &forward_edge_yf);
	CatClock_CalculateHandOriginsFloat(phase, pivot_axis_xf, pivot_axis_yf, scale,
									   back_pivot_length, &back_origin_xf, &back_origin_yf);

	// 3. Compute precision continuous delta vector for cross-normal calculations
	float spine_dx = forward_edge_xf - back_origin_xf;
	float spine_dy = forward_edge_yf - back_origin_yf;

	// 4. Invoke the layout wrapper to generate clean integer base terminals
	int base_start_x = 0, base_start_y = 0;
	int base_end_x = 0, base_end_y = 0;
	CatClock_CalculateHandBaseCorners(phase, spine_dx, spine_dy, back_origin_xf, back_origin_yf,
									  scale, base_width, &base_start_x, &base_start_y, &base_end_x,
									  &base_end_y);

	// 5. Opt into the bounded wrapper function for the tip to clip cleanly at cell margins
	int tip_x = 0, tip_y = 0;
	CatClock_CalculateHandEndpoints(phase, (int) roundf(pivot_axis_xf), (int) roundf(pivot_axis_yf),
									scale, cell_x, cell_y, &tip_x, &tip_y);

	// 6. Calculate layout scaling limits based on the clamped tip coordinates
	float torso_spine_xf = back_origin_xf + (((float) tip_x - back_origin_xf) * mid_factor);
	float torso_spine_yf = back_origin_yf + (((float) tip_y - back_origin_yf) * mid_factor);

	// Re-verify the continuous vector delta for the forward section to align the shoulders
	float shoulder_dx = (float) tip_x - back_origin_xf;
	float shoulder_dy = (float) tip_y - back_origin_yf;

	// 7. Invoke the layout wrapper to generate clean integer shoulder terminals
	int shoulder_start_x = 0, shoulder_start_y = 0;
	int shoulder_end_x = 0, shoulder_end_y = 0;
	CatClock_CalculateHandBaseCorners(phase, shoulder_dx, shoulder_dy, torso_spine_xf,
									  torso_spine_yf, scale, base_width * 0.85f, &shoulder_start_x,
									  &shoulder_start_y, &shoulder_end_x, &shoulder_end_y);

	// ============================================================================
	// 🛠️ ISOLATED WIREFRAME DEBUGPASS
	// Completely bypasses triangle raster blocks to isolate geometry layout errors
	// ============================================================================
	DrawDebugReferenceLine(buffer, sheet_w, sheet_h, base_start_x, base_start_y, base_end_x,
						   base_end_y, palette_hand_idx);
	DrawDebugReferenceLine(buffer, sheet_w, sheet_h, shoulder_start_x, shoulder_start_y,
						   shoulder_end_x, shoulder_end_y, palette_hand_idx);
	DrawDebugReferenceLine(buffer, sheet_w, sheet_h, (int) roundf(back_origin_xf),
						   (int) roundf(back_origin_yf), tip_x, tip_y, PALETTE_HAND_SECOND);
}

static void CatClock_CalculateHandEndpointsFloat(int phase, float pivot_x, float pivot_y,
												 float scale, float* out_end_x, float* out_end_y) {
	if (phase < 0 || phase >= TOTAL_HAND_PHASES) {
		if (out_end_x)
			*out_end_x = pivot_x;
		if (out_end_y)
			*out_end_y = pivot_y;
		return;
	}

	HandMasterOffset offset = HAND_MASTER_OFFSETS[phase];

	if (out_end_x) {
		*out_end_x = pivot_x + ((float) offset.dx * scale);
	}
	if (out_end_y) {
		*out_end_y = pivot_y + ((float) offset.dy * scale);
	}
}

